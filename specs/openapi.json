  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Segment Public API token."
      }
    },
    "responses": {
      "Error": {
        "description": "Error, decoded into ErrorResponse by uhttp.WithErrorResponse.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
