{
  "openapi": "3.0.3",
  "info": {
    "title": "Segment Public API (baton-segment surface)",
    "version": "2026-09-22",
    "description": "The subset of the Segment Public API that baton-segment calls. Scope is connector scope: nineteen operations, and only the response fields the connector's structs declare. Shapes and required flags settled against Segment's published spec, which this repo already vendors at cmd/test-server/swagger.json, and the per-endpoint doc links in pkg/connector/client/client.go (accessed 2026-09-22)."
  },
  "servers": [
    {
      "url": "https://api.segmentapis.com"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getWorkspace",
        "summary": "Get the workspace",
        "description": "pkg/connector/client/client.go GetWorkspace, and ValidateCredentials which uses it as the token probe. Not paginated.",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Workspace envelope.",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "workspace"
                      ],
                      "properties": {
                        "workspace": {
                          "$ref": "#/components/schemas/Workspace"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List IAM users",
        "description": "client.go ListUsers. Paginated: cursor is data.pagination.next -> pagination.cursor.",
        "parameters": [
          {
            "name": "pagination.count",
            "in": "query",
            "required": false,
            "description": "Page size. Sent on every paginated call.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pagination.cursor",
            "in": "query",
            "required": false,
            "description": "Cursor from the previous response's data.pagination.next. Omitted on the first page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListUsersResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteUsers",
        "summary": "Delete users",
        "description": "client.go DeleteUser. The user is identified by an indexed query param, not a path param: userIds.0.",
        "parameters": [
          {
            "name": "userIds.0",
            "in": "query",
            "required": true,
            "description": "Indexed list param. The connector deletes one user per call.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users deleted. The connector does not decode the body."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
