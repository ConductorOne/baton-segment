					"name": "Add Users to Group",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.segment.v1+json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"emails\": [\n        \"alice.johnson@example.com\"\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/groups/{{group_id}}/users",
							"host": ["{{base_url}}"],
							"path": ["groups", "{{group_id}}", "users"]
						},
						"description": "Adds users to a group by email.\n\n**API Docs**: https://docs.segmentapis.com/tag/IAM-Groups#operation/addUsersToUserGroup"
					}
				},
