{
	"info": {
		"_postman_id": "baton-segment",
		"name": "Twilio Segment API",
		"description": "API collection for the Baton Twilio Segment V2 connector.\n\nThis collection includes all endpoints used by the connector for syncing IAM resources and provisioning.\n\n**Authentication**: Bearer token (Personal Access Token)\n\n**Base URL**: https://api.segmentapis.com (production) or http://localhost:8080 (test server)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "test-segment-token-12345",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "user_001",
			"type": "string"
		},
		{
			"key": "group_id",
			"value": "group_001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Workspace",
			"description": "Workspace endpoint - returns the workspace associated with the access token.",
			"item": [
				{
					"name": "Get Workspace",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.segment.v1+json"
							}
						],
						"url": {
							"raw": "{{base_url}}/",
							"host": ["{{base_url}}"],
							"path": [""]
						},
						"description": "Returns the Workspace associated with the token used to access this resource.\n\n**API Docs**: https://docs.segmentapis.com/tag/Workspace#operation/getWorkspace"
					}
				}
			]
		},
		{
			"name": "Users",
			"description": "IAM Users endpoints - manage workspace users.",
			"item": [
				{
					"name": "List Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.segment.v1+json"
							}
						],
						"url": {
							"raw": "{{base_url}}/users?pagination.count=100",
							"host": ["{{base_url}}"],
							"path": ["users"],
							"query": [
								{
									"key": "pagination.count",
									"value": "100",
									"description": "Number of items per page"
								},
								{
									"key": "pagination.cursor",
									"value": "",
									"description": "Cursor for pagination",
									"disabled": true
								}
							]
						},
						"description": "Returns a list of users with their permissions.\n\n**API Docs**: https://docs.segmentapis.com/tag/IAM-Users#operation/listUsers"
					}
				},
				{
					"name": "Get User",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.segment.v1+json"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}"]
						},
						"description": "Returns a single user by ID with their permissions.\n\n**API Docs**: https://docs.segmentapis.com/tag/IAM-Users#operation/getUser"
					}
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.segment.v1+json"
							}
						],
						"url": {
							"raw": "{{base_url}}/users?userIds.0={{user_id}}",
							"host": ["{{base_url}}"],
							"path": ["users"],
							"query": [
								{
									"key": "userIds.0",
									"value": "{{user_id}}",
									"description": "User ID to delete"
								}
							]
						},
						"description": "Removes a user from the workspace.\n\n**API Docs**: https://docs.segmentapis.com/tag/IAM-Users#operation/deleteUsers"
					}
				},
				{
					"name": "Update User Permissions",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/vnd.segment.v1+json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"permissions\": [\n        {\n            \"roleId\": \"role_workspace_admin\",\n            \"resources\": [\n                {\n                    \"id\": \"workspace_001\",\n                    \"type\": \"WORKSPACE\"\n                }\n            ]\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/{{user_id}}/permissions",
							"host": ["{{base_url}}"],
							"path": ["users", "{{user_id}}", "permissions"]
						},
						"description": "Replaces all permissions for a user.\n\n**API Docs**: https://docs.segmentapis.com/tag/IAM-Users#operation/replacePermissionsForUser"
					}
				}
			]
		},
