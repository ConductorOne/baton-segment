								"value": "application/vnd.segment.v1+json"
							}
						],
						"url": {
							"raw": "{{base_url}}/groups/{{group_id}}/users?emails.0=alice.johnson@example.com",
							"host": ["{{base_url}}"],
							"path": ["groups", "{{group_id}}", "users"],
							"query": [
								{
									"key": "emails.0",
									"value": "alice.johnson@example.com",
									"description": "Email of user to remove"
								}
							]
						},
						"description": "Removes users from a group by email.\n\n**API Docs**: https://docs.segmentapis.com/tag/IAM-Groups#operation/removeUsersFromUserGroup"
					}
				},
