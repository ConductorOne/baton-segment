								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"permissions\": [\n        {\n            \"roleId\": \"role_source_admin\",\n            \"resources\": [\n                {\n                    \"id\": \"workspace_001\",\n                    \"type\": \"WORKSPACE\"\n                }\n            ]\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/groups/{{group_id}}/permissions",
